<%-- Ícones SVG inline reaproveitados em várias telas --%>
<%
    request.setAttribute("ic_grid", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/></svg>");
    request.setAttribute("ic_building", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\"/><path d=\"M9 8h1M14 8h1M9 12h1M14 12h1M9 16h1M14 16h1\"/></svg>");
    request.setAttribute("ic_layers", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2 2 7l10 5 10-5-10-5z\"/><path d=\"M2 17l10 5 10-5\"/><path d=\"M2 12l10 5 10-5\"/></svg>");
    request.setAttribute("ic_check", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 11l3 3L22 4\"/><path d=\"M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11\"/></svg>");
    request.setAttribute("ic_alert", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z\"/><path d=\"M12 9v4M12 17h.01\"/></svg>");
    request.setAttribute("ic_clock", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 3\"/></svg>");
    request.setAttribute("ic_out", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4\"/><path d=\"M16 17l5-5-5-5\"/><path d=\"M21 12H9\"/></svg>");
    request.setAttribute("ic_plus", "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M12 5v14M5 12h14\"/></svg>");
    request.setAttribute("ic_eye", "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>");
    request.setAttribute("ic_doc", "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/></svg>");
    request.setAttribute("ic_back", "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"><path d=\"M19 12H5M12 19l-7-7 7-7\"/></svg>");
    request.setAttribute("ic_tap", "<svg width=\"34\" height=\"34\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M9 11.24V7.5a2.5 2.5 0 015 0v3.74M14 10.5V6a2.5 2.5 0 015 0v10a7 7 0 01-14 0v-2.5\"/></svg>");

    /* Figuras dos equipamentos de segurança contra incêndio, usadas na barra de ferramentas e nos marcadores da planta */
    request.setAttribute("ic_equip_extintor", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><rect x=\"9\" y=\"9\" width=\"8\" height=\"12\" rx=\"2\" fill=\"#fff\"/><rect x=\"11\" y=\"4\" width=\"2.4\" height=\"5\" fill=\"#fff\"/><rect x=\"7\" y=\"3\" width=\"6\" height=\"2\" rx=\"1\" fill=\"#fff\"/><path d=\"M13 6 L18 4\" stroke=\"#fff\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"18.4\" cy=\"3.6\" r=\"1.1\" fill=\"#fff\"/></svg>");
    request.setAttribute("ic_equip_saida", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><rect x=\"4\" y=\"4\" width=\"6\" height=\"16\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\"/><path d=\"M10 12h9M15.5 8l4 4-4 4\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>");
    request.setAttribute("ic_equip_hidrante", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><rect x=\"10\" y=\"7\" width=\"4\" height=\"11\" rx=\"1.5\" fill=\"#fff\"/><rect x=\"7\" y=\"16\" width=\"10\" height=\"2.4\" rx=\"1\" fill=\"#fff\"/><rect x=\"6.5\" y=\"9\" width=\"3\" height=\"2\" rx=\"1\" fill=\"#fff\"/><rect x=\"14.5\" y=\"9\" width=\"3\" height=\"2\" rx=\"1\" fill=\"#fff\"/><circle cx=\"12\" cy=\"5.5\" r=\"2\" fill=\"#fff\"/></svg>");
    request.setAttribute("ic_equip_iluminacao", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><circle cx=\"12\" cy=\"10\" r=\"5.5\" fill=\"#fff\"/><rect x=\"9.5\" y=\"15.5\" width=\"5\" height=\"2\" fill=\"#fff\"/><rect x=\"10\" y=\"18\" width=\"4\" height=\"1.6\" rx=\"0.8\" fill=\"#fff\"/></svg>");
    request.setAttribute("ic_equip_alarme", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><path d=\"M12 3a1.5 1.5 0 011.5 1.5v.6C16.5 5.9 18 8.2 18 11v4l2 2.5H4L6 15v-4c0-2.8 1.5-5.1 4.5-5.9v-.6A1.5 1.5 0 0112 3z\" fill=\"#fff\"/><path d=\"M9.5 19a2.5 2.5 0 005 0z\" fill=\"#fff\"/></svg>");
    request.setAttribute("ic_equip_observacao", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><circle cx=\"12\" cy=\"12\" r=\"1.6\" fill=\"#fff\"/><rect x=\"10.6\" y=\"4\" width=\"2.8\" height=\"9\" rx=\"1.4\" fill=\"#fff\"/></svg>");
    request.setAttribute("ic_equip_rota", "<svg viewBox=\"0 0 24 24\" width=\"100%\" height=\"100%\"><path d=\"M4 18c4-8 8-8 12-13\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M11 3h5v5\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>");
